managed implementation in class ZBP_R_CLINIC_DOCTOR unique;
strict ( 2 );
with draft;
with cross associations;
extensible;
define behavior for ZR_CLINIC_DOCTOR alias Doctor
persistent table ZCLINIC_DOCTOR
extensible
draft table ZCLINIC_DOCTOR_D
etag master LocalLastChangedAt
lock master total etag LastChangedAt
authorization master( global )
{

  field ( readonly : update, numbering : managed )
   Doctoruuid;

  field ( readonly )
   CreatedBy,
   CreatedAt,
   LastChangedBy,
   LastChangedAt,
   LocalLastChangedAt;

//Acciones CRUD
  create;
  update;
  delete;
//Añadimos la asociación con la tabla/entidad DocSpec
//  association _DocSpec;

//Acciones custom
  action ( features : instance ) DeactivateDoctor ;
  action ( features : instance ) ReactivateDoctor;



  side effects {

  action DeactivateDoctor affects
  field Active,
  permissions ( action DeactivateDoctor ),
  permissions ( action ReactivateDoctor );

  action ReactivateDoctor affects
  field Active,
  permissions ( action ReactivateDoctor ),
  permissions ( action DeactivateDoctor );

  }

  draft action Activate optimized;
  draft action Discard;
  draft action Edit;
  draft action Resume;
  draft determine action Prepare;

  mapping for ZCLINIC_DOCTOR corresponding extensible
  {
    DoctorUUID = DOCTORUUID;
    FirstName = FIRSTNAME;
    LastName = LASTNAME;
    LicenseNumber = LICENSENUMBER;
    Phone = PHONE;
    Email = EMAIL;
    Active = ACTIVE;
    CreatedBy = CREATED_BY;
    CreatedAt = CREATED_AT;
    LastChangedBy = LAST_CHANGED_BY;
    LastChangedAt = LAST_CHANGED_AT;
    LocalLastChangedAt = LOCAL_LAST_CHANGED_AT;
  }

}