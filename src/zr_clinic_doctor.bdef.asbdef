managed implementation in class ZBP_R_CLINIC_DOCTOR unique;
strict ( 2 );
with draft;
with cross associations;
extensible;
define behavior for ZR_CLINIC_DOCTOR alias Doctor
persistent table zclinic_doctor
extensible
draft table zclinic_doctor_d
etag master LocalLastChangedAt
lock master total etag LastChangedAt
authorization master ( global )
{

  field ( readonly : update, numbering : managed )
  Doctoruuid;

  field ( readonly )
  CreatedBy,
  CreatedAt,
  LastChangedBy,
  LastChangedAt,
  LocalLastChangedAt;

  //Acciones CRUD
  create;
  update;
  delete;
  //Añadimos la Composición con la tabla/entidad DocSpec
  association _DocSpec {
    create;
    with draft;
  }

  //ACCIONES CUSTOM
  //Borrado lógico
  action ( features : instance ) DeactivateDoctor;
  action ( features : instance ) ReactivateDoctor;
  //Añadir especialidad
  action ( features : instance ) AddSpecialty
    parameter ZCE_CLINIC_SPEC_ACTION;
  action ( features : instance ) RemoveSpecialty
    parameter ZCE_CLINIC_SPEC_ACTION;
  //Habilitar Citas para médico
  action GenerateAvailability
    parameter ZCE_CLINIC_DATE_DAY
    result [1] ZCE_CLINIC_NUMBER_DATES_RESULT;



  side effects
  {

    action DeactivateDoctor affects
        field Active,
        permissions ( action DeactivateDoctor ),
        permissions ( action ReactivateDoctor );

    action ReactivateDoctor affects
        field Active,
        permissions ( action ReactivateDoctor ),
        permissions ( action DeactivateDoctor );

  }

  draft action Activate optimized;
  draft action Discard;
  draft action Edit;
  draft action Resume;
  draft determine action Prepare;

  mapping for zclinic_doctor corresponding extensible
    {
      DoctorUUID         = DOCTORUUID;
      FirstName          = FIRSTNAME;
      LastName           = LASTNAME;
      LicenseNumber      = LICENSENUMBER;
      Phone              = PHONE;
      Email              = EMAIL;
      Active             = ACTIVE;
      CreatedBy          = CREATED_BY;
      CreatedAt          = CREATED_AT;
      LastChangedBy      = LAST_CHANGED_BY;
      LastChangedAt      = LAST_CHANGED_AT;
      LocalLastChangedAt = LOCAL_LAST_CHANGED_AT;
    }

}

define behavior for ZR_CLINIC_DOC_SPEC alias DocSpec
persistent table zclinic_doc_spec
draft table zclnc_doc_spec_d
lock dependent by _Doctor
authorization dependent by _Doctor
{
    update;
    delete;

    association _Doctor {
        with draft;
    }
    association _Spec;

    field ( readonly : update )
        Doctoruuid,
        Specuuid;


    field ( readonly )
        CreatedBy,
        CreatedAt,
        LastChangedBy,
        LastChangedAt,
        LocalLastChangedAt;

    mapping for zclinic_doc_spec corresponding
    {
        DoctorUUID = DOCTORUUID;
        SpecUUID = SPECUUID;
        CreatedBy = CREATED_BY;
        CreatedAt = CREATED_AT;
        LastChangedBy = LAST_CHANGED_BY;
        LastChangedAt = LAST_CHANGED_AT;
        LocalLastChangedAt = LOCAL_LAST_CHANGED_AT;
    }
}