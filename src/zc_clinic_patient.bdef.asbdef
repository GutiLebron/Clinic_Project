projection implementation in class ZBP_C_CLINIC_PATIENT unique;
strict ( 2 );
extensible;
use draft;
use side effects;
define behavior for ZC_CLINIC_PATIENT alias Patient
extensible
use etag
{
  use create;
  use update;
  //use delete; Haremos borrado lógic

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use action DeactivatePatient;
  use action ReactivatePatient;

}