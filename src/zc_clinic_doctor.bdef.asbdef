projection implementation in class ZBP_C_CLINIC_DOCTOR unique;
strict ( 2 );
extensible;
use draft;
use side effects;
define behavior for ZC_CLINIC_DOCTOR alias Doctor
extensible
use etag
{

  use create;
  use update;
  //use delete; Borrado lógico

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  //Acciones Custom
  use action DeactivateDoctor;
  use action ReactivateDoctor;
}