@Metadata.layer: #CORE
@UI.headerInfo.title.type: #STANDARD
@UI.headerInfo.title.value: 'LastName'
@UI.headerInfo.description.type: #STANDARD
@UI.headerInfo.description.value: 'FirstName'
annotate view ZC_CLINIC_DOCTOR with
{
//Facet para DATOS
  @UI.facet: [ {
    label: 'Datos Doctor', 
    id: 'GeneralInfo', 
    purpose: #STANDARD, 
    position: 10 , 
    type: #IDENTIFICATION_REFERENCE,
    targetQualifier: 'GeneralInfo'
    },
//Facet para CONTACTO
    {
    label: 'Contacto Doctor', 
    id: 'Contact', 
    purpose: #STANDARD, 
    position: 20, 
    type: #IDENTIFICATION_REFERENCE,
    targetQualifier: 'Contact'
  },
//Facet para ACCIONES  
  { 
  label: 'Acciones', 
    id: 'GeneralActions', 
    purpose: #STANDARD, 
    position: 30 , 
    type: #IDENTIFICATION_REFERENCE,
    targetQualifier: 'GeneralActions'  
  }]  
//FIN DE FACET


  @EndUserText.label: 'Doctoruuid'
  @UI.identification: [ {
    qualifier: 'GeneralInfo',
    position: 10 , 
    label: 'Doctoruuid'
  },
  {
    qualifier: 'GeneralActions',
    type: #FOR_ACTION,
    dataAction: 'ReactivateDoctor',
    label: 'Reactivate Doctor',
    position: 10 
  },
  { 
  qualifier: 'GeneralActions',
    type: #FOR_ACTION,
    dataAction: 'DeactivateDoctor',
    label: 'Deactivate Doctor',
    position: 20
  } ]
  DoctorUUID;
  
  @EndUserText.label: 'Nombre'
  @UI.identification: [ {
    qualifier: 'GeneralInfo',
    position: 20 , 
    label: 'Firstname'
  } ]
  @UI.lineItem: [ {
    position: 20 , 
    label: 'Firstname'
  } ]
  @UI.selectionField: [ {
    position: 20 
  } ]
  FirstName;
  
  @EndUserText.label: 'Apellidos'
  @UI.identification: [ {
    qualifier: 'GeneralInfo',
    position: 30 , 
    label: 'Lastname'
  } ]
  @UI.lineItem: [ {
    position: 30 , 
    label: 'Lastname'
  } ]
  @UI.selectionField: [ {
    position: 30 
  } ]
  LastName;
  
  @EndUserText.label: 'Nº Colegiado'
  @UI.identification: [ {
    qualifier: 'GeneralInfo',
    position: 40 , 
    label: 'Licensenumber'
  } ]
  @UI.lineItem: [ {
    position: 40 , 
    label: 'Licensenumber'
  } ]
  @UI.selectionField: [ {
    position: 40 
  } ]
  LicenseNumber;
  
  @EndUserText.label: 'Teléfono'
  @UI.identification: [ {
    qualifier: 'Contact',
    position: 50 , 
    label: 'Phone'
  } ]
  @UI.lineItem: [ {
    position: 50 , 
    label: 'Phone'
  } ]
  Phone;
  
  @EndUserText.label: 'Correo Electónico'
  @UI.identification: [ {
    qualifier: 'Contact',
    position: 60 , 
    label: 'Email'
  } ]
  @UI.lineItem: [ {
    position: 60 , 
    label: 'Email'
  } ]
  Email;
  
  @EndUserText.label: 'Activo'
  @UI.identification: [ {
    qualifier: 'GeneralInfo',
    position: 70 , 
    label: 'Active'
  } ]
  @UI.lineItem: [ {
    position: 70 , 
    label: 'Active'
  } ]
  @UI.selectionField: [ {
    position: 70 
  } ]
  Active;
  
}