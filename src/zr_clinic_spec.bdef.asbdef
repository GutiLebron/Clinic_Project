managed implementation in class ZBP_R_CLINIC_SPEC unique;
strict ( 2 );
with draft;
extensible;
define behavior for ZR_CLINIC_SPEC alias Spec
persistent table ZCLINIC_SPEC
extensible
draft table ZCLINIC_SPEC_D
etag master LocalLastChangedAt
lock master total etag LastChangedAt
authorization master( global )
{
  field ( readonly : update, numbering : managed )
   Specuuid;

  field ( readonly )
   CreatedBy,
   CreatedAt,
   LastChangedBy,
   LastChangedAt,
   LocalLastChangedAt;

  create;
  update;
  delete;

  action ( features : instance ) DeactivateSpec;
  action ( features : instance ) ReactivateSpec;

  side effects {

  action DeactivateSpec affects
    field Active,
    permissions( action DeactivateSpec ),
    permissions( action ReactivateSpec );

  action ReactivateSpec affects
    field Active,
    permissions( action DeactivateSpec ),
    permissions( action ReactivateSpec );

}

  draft action Activate optimized;
  draft action Discard;
  draft action Edit;
  draft action Resume;
  draft determine action Prepare;

  mapping for ZCLINIC_SPEC corresponding extensible
  {
    Specuuid = SPECUUID;
    Name = NAME;
    Active = ACTIVE;
    CreatedBy = CREATED_BY;
    CreatedAt = CREATED_AT;
    LastChangedBy = LAST_CHANGED_BY;
    LastChangedAt = LAST_CHANGED_AT;
    LocalLastChangedAt = LOCAL_LAST_CHANGED_AT;
  }

}